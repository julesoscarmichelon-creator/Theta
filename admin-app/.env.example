# =====================================================================
#  Espace d'administration Theta — variables d'environnement
#  Copier ce fichier en `.env` pour le developpement local, et recopier
#  les memes cles dans le projet Vercel « theta-admin » en production.
#  Le fichier `.env` ne doit JAMAIS etre versionne (voir .gitignore).
# =====================================================================

# --- Acces -----------------------------------------------------------
# Mot de passe unique de l'espace d'administration (12 caracteres minimum).
ADMIN_PASSWORD=un-mot-de-passe-long-et-unique

# Cle de signature des cookies de session (32 caracteres minimum).
# A generer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-64-caracteres

# Duree d'une session, en heures.
ADMIN_SESSION_HOURS=12

# Nombre de tentatives de connexion autorisees par IP, et duree de la
# fenetre en secondes.
ADMIN_LOGIN_MAX=10
ADMIN_LOGIN_WINDOW_SECONDS=900

# Uniquement pour un essai en local sur http:// (jamais en production) :
# retire l'attribut `Secure` du cookie de session.
# ADMIN_COOKIE_INSECURE=true

# --- Magasin partage avec le site principal --------------------------
# EXACTEMENT les memes valeurs que dans le projet `contact-api`, sinon
# l'admin ne verra pas les demandes recues par le formulaire.
# Fournies automatiquement par l'integration Vercel (Storage > Redis) ;
# les noms UPSTASH_REDIS_REST_* sont acceptes en equivalent.
KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
