# =====================================================================
#  Microservice de contact — variables d'environnement
#  Copier ce fichier en `.env` pour le developpement local, et recopier
#  les memes cles dans l'interface de l'hebergeur en production.
#  Le fichier `.env` ne doit JAMAIS etre versionne (voir .gitignore).
# =====================================================================

# --- Fournisseur d'envoi : "resend" (recommande) ou "smtp" ------------
MAIL_PROVIDER=resend

# --- Destinataire ----------------------------------------------------
# Votre boite mail. Plusieurs adresses possibles, separees par une virgule.
MAIL_TO=contact@michelon-co.fr

# Expediteur affiche. Avec Resend, le domaine doit etre verifie chez eux ;
# tant qu'il ne l'est pas, utiliser onboarding@resend.dev pour tester.
MAIL_FROM=Formulaire Michelon & Co <contact@michelon-co.fr>

# Prefixe du sujet des e-mails recus.
MAIL_SUBJECT_PREFIX=Nouveau message — Michelon & Co

# --- Option A : Resend (https://resend.com) --------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Option B : SMTP classique (OVH, Infomaniak, Gmail...) -----------
# Utilise uniquement si MAIL_PROVIDER=smtp
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@michelon-co.fr
SMTP_PASS=motdepasse-application

# --- Repli sans JavaScript (facultatif) ------------------------------
# Si un visiteur a JavaScript desactive, le formulaire poste directement
# vers l'API : ces deux pages lui servent alors de confirmation/erreur.
SUCCESS_REDIRECT_URL=https://theta-zeta.vercel.app/merci.html
ERROR_REDIRECT_URL=https://theta-zeta.vercel.app/#contact

# --- Securite --------------------------------------------------------
# Domaines AUTRES que celui de l'API, autorises a l'appeler (CORS).
# A laisser vide si le site et l'API sont sur le meme domaine (cas du
# deploiement Vercel unique) : les pages du meme domaine sont toujours
# acceptees, URL de previsualisation comprises.
# Sinon : origine exacte, protocole compris, sans slash final, separees
# par une virgule.
ALLOWED_ORIGINS=

# Nombre maximum d'envois par IP et par fenetre de temps.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Longueur maximale du message, et delai minimum de remplissage du
# formulaire en secondes (un robot repond instantanement).
MAX_MESSAGE_LENGTH=5000
MIN_SUBMIT_SECONDS=2

# --- Espace prive (/admin) -------------------------------------------
# Mot de passe unique d'acces au tableau de bord des demandes.
# A definir dans l'hebergeur, jamais dans le depot.
ADMIN_PASSWORD=

# Variante : ne stocker que le condensat SHA-256 du mot de passe.
# Genere avec :  printf '%s' 'mon-mot-de-passe' | sha256sum
# Si les deux sont presents, c'est le condensat qui fait foi.
ADMIN_PASSWORD_SHA256=

# Duree d'une session ouverte, en heures (12 par defaut).
ADMIN_SESSION_HOURS=12

# Cle de signature des sessions. Laissee vide, elle est derivee du mot de
# passe : changer le mot de passe ferme alors les sessions en cours.
ADMIN_SESSION_SECRET=

# Nombre maximum de tentatives de connexion par IP et par fenetre.
ADMIN_LOGIN_MAX=10

# --- Conservation des demandes ---------------------------------------
# Production : ajouter une base KV (Redis) au projet Vercel. L'integration
# injecte KV_REST_API_URL et KV_REST_API_TOKEN toute seule — rien a
# recopier ici. Upstash direct fonctionne aussi
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Developpement local : un simple fichier JSON, utilise si aucune base KV
# n'est configuree. A laisser vide en production.
STORE_FILE=.data/submissions.json

# Nom de la liste et nombre de demandes conservees.
STORE_KEY=contact:submissions
STORE_MAX=500

# --- Serveur Express uniquement --------------------------------------
PORT=3000
